scalar Instant
scalar Void

type Query {
    "Anyone logged in. The caller and their roles."
    me: Me!
    "USER. The start page texts and the upload limit."
    settings: Settings!
    "USER. Videos by year, newest first, or in the filter's order. Unpublished, processing and failed ones only for EDITOR, when asked for."
    videos(filter: VideoFilter): [Video!]!
    "USER. A video; unpublished, unprocessed or trashed ones only for EDITOR."
    video(id: ID!): Video
    "USER. The most recently published videos."
    recentVideos(limit: Int = 12): [Video!]!
    "USER. Videos the caller has started but not finished, most recent first."
    continueWatching(limit: Int = 12): [Video!]!
    "USER. The caller's watch list."
    watchList: [Video!]!
    "USER. Listed videos the caller rated, highest first."
    highestRated(limit: Int = 12): [Video!]!
    "USER. Listed videos the caller likes, most recently liked first."
    likedVideos: [Video!]!
    "USER. Listed videos ranked by everyone: by weighted average rating, likes or views to the end. Videos without any are left out. The filter's sort, liked and unwatched are ignored."
    topVideos(by: TopBy = RATED, filter: VideoFilter, limit: Int = 20): [Video!]!
    "USER. The caller's playlists, by name, then everyone's public ones."
    playlists: [Playlist!]!
    "USER. One of the caller's playlists, or a public one."
    playlist(id: ID!): Playlist
    "USER. Collections with a listed video, by title; every collection for EDITOR."
    collections: [Collection!]!
    "USER. A collection with a listed video; any collection for EDITOR."
    collection(id: ID!): Collection
    "USER. The video kinds, in order; the first is the default."
    videoKinds: [VideoKind!]!
    "USER. The categories of the published videos."
    categories: [Category!]!
    "USER. The years of the published videos, newest first."
    years: [Int!]!
    "USER. Everyone credited in the listed videos (every video outside the trash for EDITOR), by name, with how many videos each."
    credits: [Credit!]!
    "USER. The videos that credit a name, regardless of case, newest first, with what the name does in each."
    creditVideos(name: String!): [CreditedVideo!]!
    "USER. Videos whose titles, spex, descriptions, performances or chapters match."
    search(q: String!): [Video!]!
    "USER. Signed addresses for playing a ready video, valid for its duration plus a margin."
    playback(videoId: ID!): Playback!
    "EDITOR. Spex in Spexregister matching a title or year: each original, then its revivals, newest original first. An original is included when only a revival matches."
    spexSearch(q: String!): [Spex!]!
    "EDITOR. The published Spexify tracks of the video's spex and their originals' revivals, for linking chapters; empty when Spexify is unavailable."
    spexifyTracks(videoId: ID!): [SpexifyTrack!]!
    "SPEXIFY or USER. Chapters of published videos linked to the given Spexify tracks."
    chapterLinks(trackIds: [ID!]!): [ChapterLink!]!
    "EDITOR. Trashed videos."
    trash: [Video!]!
    "EDITOR. Running, waiting and recent processing jobs."
    processingQueue: [ProcessingJob!]!
    "ADMIN. Space used by originals and renditions, and left on the volume."
    storage: Storage!
    "EDITOR. The audit log, newest first: the caller's own changes, or everyone's for ADMIN, narrowed by the filter."
    auditLog(page: Int = 0, size: Int = 50, filter: AuditFilter): AuditPage!
    "EDITOR. Who made the changes in the audit log the caller sees, with their latest names; only the caller unless ADMIN."
    auditActors: [AuditActor!]!
    "ADMIN. The scheduled maintenance jobs, with their schedules and how their latest runs went."
    maintenanceJobs: [MaintenanceJobStatus!]!
}

type Mutation {
    "EDITOR. New videos start unpublished, waiting for their file."
    videoCreate(input: VideoInput!): Video!
    "EDITOR."
    videoUpdate(id: ID!, input: VideoInput!): Video!
    "EDITOR. Takes a finished upload as the video's file, first or as a replacement, and queues it for processing."
    videoSetFile(id: ID!, uploadId: String!): Video!
    "EDITOR. Only READY videos can be published."
    videoPublish(id: ID!, published: Boolean!): Video!
    "EDITOR."
    videoTrash(id: ID!): Video!
    "EDITOR."
    videoRestore(id: ID!): Video!
    "ADMIN. Only a trashed video; deletes its files."
    videoDelete(id: ID!): Void
    "ADMIN. Deletes every trashed video with its files."
    trashEmpty: Void
    "EDITOR. Takes the poster from this point in the video."
    videoPosterFrame(id: ID!, seconds: Float!): Video!
    "ADMIN. Processes the original again."
    videoReprocess(id: ID!): Video!
    "EDITOR. Replaces who takes part in the video, in the given order; rows without a name are left out."
    creditsSet(videoId: ID!, credits: [CreditInput!]!): Video!
    "EDITOR. Replaces the video's chapters."
    chaptersSet(videoId: ID!, chapters: [ChapterInput!]!): Video!
    "EDITOR."
    subtitleRemove(videoId: ID!, language: String!): Video!
    "USER. Where the caller is in a video; finished when near the end."
    progressSave(videoId: ID!, positionSeconds: Int!): Void
    "USER. Forgets where the caller is in a video, which takes it off continue watching and marks it unwatched."
    progressClear(videoId: ID!): Void
    "USER. Marks a video as watched to the end; the next time it starts from the beginning."
    videoMarkWatched(videoId: ID!): Void
    "USER. Rates a video from 1 to 5; 0 removes the caller's rating."
    videoRate(videoId: ID!, rating: Int!): Void
    "USER. Likes a video, or takes the like back."
    videoLike(videoId: ID!, liked: Boolean!): Void
    "USER."
    watchListAdd(videoId: ID!): Void
    "USER."
    watchListRemove(videoId: ID!): Void
    "EDITOR. The videos in the given order; trashed ones are refused."
    collectionCreate(input: CollectionInput!): Collection!
    "EDITOR. Replaces the title, description and videos."
    collectionUpdate(id: ID!, input: CollectionInput!): Collection!
    "ADMIN. The videos stay."
    collectionDelete(id: ID!): Void
    "USER. At most 200 per user."
    playlistCreate(input: PlaylistInput!): Playlist!
    "USER. Only the caller's own."
    playlistUpdate(id: ID!, input: PlaylistInput!): Playlist!
    "USER. Only the caller's own."
    playlistDelete(id: ID!): Void
    "USER. Adds a whole video, or with startSeconds the chapter that starts there, last in one of the caller's playlists."
    playlistAddItem(playlistId: ID!, videoId: ID!, startSeconds: Int): Playlist!
    "USER."
    playlistRemoveItem(playlistId: ID!, itemId: ID!): Playlist!
    "USER. The items in the new order; items left out keep their order after them."
    playlistReorder(playlistId: ID!, itemIds: [ID!]!): Playlist!
    "ADMIN. Added last."
    videoKindCreate(input: VideoKindInput!): VideoKind!
    "ADMIN."
    videoKindUpdate(id: ID!, input: VideoKindInput!): VideoKind!
    "ADMIN. Every kind, in the new order; the first becomes the default."
    videoKindsReorder(ids: [ID!]!): [VideoKind!]!
    "ADMIN. Only a kind no video uses, trashed ones included, and not the last one."
    videoKindDelete(id: ID!): Void
    "ADMIN."
    settingsUpdate(input: SettingsInput!): Settings!
    "ADMIN. Starts the job in the background, as its schedule would. False when it is already running."
    maintenanceJobRun(job: MaintenanceJob!): Boolean!
}

type Me {
    username: String!
    displayName: String
    roles: [String!]!
    "Whether the caller also has access to Spexify, for showing links there."
    spexifyUser: Boolean!
}

type Settings {
    welcomeSv: String
    welcomeEn: String
    maxUploadGb: Int!
    "Whether originals are kept after processing, as the archive copy."
    keepOriginals: Boolean!
}

input SettingsInput {
    welcomeSv: String
    welcomeEn: String
    maxUploadGb: Int!
    keepOriginals: Boolean!
}

"What a video is, e.g. a full show or a trailer. Configured by admins."
type VideoKind {
    id: ID!
    nameSv: String!
    nameEn: String!
    position: Int!
    "The first by position: used for new videos."
    isDefault: Boolean!
    "Videos of this kind, trashed ones included."
    videoCount: Int!
}

input VideoKindInput {
    nameSv: String!
    nameEn: String!
}

enum VideoStatus {
    UPLOADING
    PROCESSING
    READY
    FAILED
}

input VideoFilter {
    "The main spex's category."
    categoryId: ID
    year: Int
    "Videos about the spex or, when it is an original, one of its revivals."
    spexId: ID
    kindId: ID
    "EDITOR only."
    includeUnpublished: Boolean
    "Videos from this year on."
    fromYear: Int
    "Videos up to and including this year."
    toYear: Int
    "Only videos the caller likes."
    liked: Boolean
    "Only videos the caller has not watched to the end."
    unwatched: Boolean
    sort: VideoSort
}

"How to order videos. Ties keep the default order: newest year first, then title."
enum VideoSort {
    "Newest year first; the default."
    YEAR_DESC
    YEAR_ASC
    TITLE
    "Most recently published first."
    PUBLISHED
    "Highest weighted average rating first; unrated videos last."
    RATING
    "Most liked first."
    LIKES
}

"What a top list ranks by."
enum TopBy {
    "Everyone's ratings, as an average weighed against two votes of the mean of all ratings, so that one 5 does not top the list."
    RATED
    "How many like the video."
    LIKED
    "How many have watched it to the end."
    WATCHED
}

input VideoInput {
    "Spex in Spexregister, the main one first, e.g. several for a jubilee show. Empty when the video is not about any spex."
    spexIds: [ID!]! = []
    "Defaults to the main spex's title; required without a spex."
    title: String
    "Defaults to the main spex's year."
    year: Int
    "A video kind; defaults to the first one for a new video and to the current one for an existing video."
    kindId: ID
    "e.g. Premiere"
    performance: String
    "yyyy-mm-dd"
    performanceDate: String
    description: String
}

input ChapterInput {
    startSeconds: Int!
    title: String!
    "A track in Spexify, from spexifyTracks."
    spexifyTrackId: ID
    spexifyTrackTitle: String
}

type Category {
    id: ID!
    name: String!
    videoCount: Int!
}

type Spex {
    id: ID!
    title: String
    year: Int
    revival: Boolean!
    "The original, for a revival."
    parentId: ID
    categoryName: String
}

type VideoSpex {
    id: ID!
    title: String
    year: Int
    revival: Boolean
    "The original, for a revival; null until the nightly refresh for spex linked before Spexflix kept it."
    parentId: ID
    "The original spex: the parent of a revival, else the spex itself. Revivals share it with their original."
    familyId: ID!
    categoryId: ID
    categoryName: String
}

type Video {
    id: ID!
    title: String!
    year: Int
    kind: VideoKind!
    performance: String
    performanceDate: String
    description: String
    "The spex the video is about, the main one first; empty when it is not about any spex. The poster falls back to the main spex's."
    spex: [VideoSpex!]!
    status: VideoStatus!
    "Why processing failed."
    failure: String
    durationMs: Float
    width: Int
    height: Int
    published: Boolean!
    publishedAt: Instant
    trashedAt: Instant
    originalName: String
    originalSize: Float
    originalKept: Boolean!
    hasThumbnails: Boolean!
    posterSeconds: Float
    renditions: [Rendition!]!
    chapters: [Chapter!]!
    "Who takes part, in order."
    credits: [VideoCredit!]!
    subtitles: [Subtitle!]!
    "The caller's position, in seconds, or null."
    progressSeconds: Int
    "Whether the caller has watched to the end."
    finished: Boolean!
    inWatchList: Boolean!
    "Whether the caller likes the video."
    liked: Boolean!
    "How many like the video."
    likeCount: Int!
    "How many have watched the video to the end."
    watchCount: Int!
    "The caller's rating, 1 to 5, or 0 when not rated."
    myRating: Int!
    "Everyone's average rating, or null when nobody has rated it."
    averageRating: Float
    ratingCount: Int!
    "The collections the video is in, by title."
    collections: [CollectionRef!]!
    "What plays after this video: the next in its first collection that has one, else the next of the same main spex (revivals counting as their original) by kind and performance date. Ask for one video at a time."
    next: Video
    "The latest processing job, for EDITOR."
    job: ProcessingJob
    createdAt: Instant!
    lastModifiedAt: Instant
}

type Rendition {
    height: Int!
    width: Int!
    bitrateKbps: Int!
    copied: Boolean!
    size: Float!
}

type Chapter {
    startSeconds: Int!
    title: String!
    spexifyTrackId: ID
    spexifyTrackTitle: String
}

type Subtitle {
    language: String!
    label: String!
}

type Playback {
    masterUrl: String!
    "WebVTT index of the timeline thumbnails, or null."
    thumbnailsUrl: String
    subtitles: [PlaybackSubtitle!]!
    expiresAt: Instant!
}

type PlaybackSubtitle {
    language: String!
    label: String!
    url: String!
}

type SpexifyTrack {
    id: ID!
    title: String!
    discNumber: Int!
    trackNumber: Int!
    albumTitle: String!
}

type ChapterLink {
    trackId: ID!
    videoId: ID!
    videoTitle: String!
    chapterTitle: String!
    startSeconds: Int!
}

type ProcessingJob {
    id: ID!
    videoId: ID!
    videoTitle: String!
    status: String!
    progress: Int!
    attempts: Int!
    error: String
    createdAt: Instant!
    startedAt: Instant
    finishedAt: Instant
}

type Storage {
    originalsBytes: Float!
    renditionsBytes: Float!
    freeBytes: Float!
    videoCount: Int!
}

type AuditPage {
    entries: [AuditLogEntry!]!
    totalCount: Int!
    page: Int!
    size: Int!
}

type AuditLogEntry {
    id: ID!
    at: Instant!
    "Who made the change, by their subject."
    actorId: String!
    actorName: String
    action: String!
    entityType: String!
    entityId: ID
    summary: String!
}

"""
A scheduled maintenance job: copying the current spex data from Spexregister (SPEX_REFRESH), and removing uploads that
were never used (UPLOAD_CLEANUP).
"""
enum MaintenanceJob {
    SPEX_REFRESH
    UPLOAD_CLEANUP
}

"A maintenance job and how its latest run went. Runs are remembered until the server restarts."
type MaintenanceJobStatus {
    job: MaintenanceJob!
    "The job's cron expression, in the server's time zone, or null when it is not scheduled."
    schedule: String
    running: Boolean!
    "When the latest run started, or null when it has not run since the server started."
    lastStartedAt: Instant
    lastFinishedAt: Instant
    "Whether the latest run finished without an error; null while it runs."
    lastSucceeded: Boolean
}

"Videos grouped in an order of their own, e.g. a spex's shows over the years."
type Collection {
    id: ID!
    title: String!
    description: String
    "Listed videos for listeners; every video not in the trash for EDITOR."
    videos: [Video!]!
    createdAt: Instant!
    lastModifiedAt: Instant
}

type CollectionRef {
    id: ID!
    title: String!
}

input CollectionInput {
    title: String!
    description: String
    videoIds: [ID!]!
}

"What to show of the audit log; every field is optional."
input AuditFilter {
    "What was changed, e.g. ALBUM or VIDEO."
    entityType: String
    "CREATE, UPDATE, DELETE and so on."
    action: String
    "Who made the change; only ADMIN sees others' changes."
    actorId: String
    "Changes from this instant on."
    from: Instant
    "Changes before this instant."
    to: Instant
    "Text the summary contains."
    q: String
    "One record's changes."
    entityId: ID
}

type AuditActor {
    id: String!
    name: String
}

"A user's own list of whole videos and clips, in an order of their own."
type Playlist {
    id: ID!
    name: String!
    description: String
    "Whether everyone can play it."
    isPublic: Boolean!
    "Whether it is the caller's own, which only the owner changes."
    owned: Boolean!
    ownerName: String
    "Listed videos and clips only."
    items: [PlaylistItem!]!
    itemCount: Int!
    durationSeconds: Float!
    createdAt: Instant!
    updatedAt: Instant!
}

"A whole video, or a clip of it: a chapter from startSeconds to endSeconds (the video's end when null), titled as the chapter was when added."
type PlaylistItem {
    id: ID!
    video: Video!
    startSeconds: Int
    endSeconds: Int
    title: String
    durationSeconds: Float!
}

input PlaylistInput {
    name: String!
    description: String
    isPublic: Boolean = false
}

"Someone who takes part in a video."
type VideoCredit {
    name: String!
    "What they do or play, e.g. Kleopatra or Regi."
    role: String
}

input CreditInput {
    name: String!
    role: String
}

type Credit {
    name: String!
    videoCount: Int!
}

type CreditedVideo {
    video: Video!
    "What the name does or plays in the video."
    role: String
}
